ROUTE_API_KEY=replace-with-a-secret-of-at-least-16-characters
# Contraseña corta de operador para POST /operador/sesion (login por cookie
# httpOnly: RoundControls ya no maneja ni guarda ROUTE_API_KEY en el
# navegador). Si se omite, el login acepta ROUTE_API_KEY como contraseña
# (compatibilidad); un despliegue real debería definirla aparte.
OPERATOR_PASSWORD=replace-with-a-separate-operator-password-of-at-least-8-characters
PORT=3001
HOST=127.0.0.1
AWS_REGION=us-east-2
# Zona de disponibilidad de EC2; DynamoDB utiliza la región, no la zona.
AWS_AVAILABILITY_ZONE=us-east-2a
DYNAMODB_TABLE_NAME=spookython-manta-state
# Vaciar/omitir DYNAMODB_TABLE_NAME selecciona memoria local; producción debe definirla.
ROUTING_WORKERS=1
ROUTING_HTTP_MAX_SOCKETS=8
# Activar solo para diagnosticar: el log de cada /paso afecta la latencia.
LOG_HTTP_REQUESTS=false
# Direcciones públicas del despliegue; Fastify conserva HTTP interno en PORT.
PUBLIC_API_URL=https://3-128-78-190.sslip.io
PUBLIC_WS_BASE_URL=wss://3-128-78-190.sslip.io
PUBLIC_WS_URL=wss://3-128-78-190.sslip.io/ws
# Lista separada por comas. Los orígenes locales 5173 y 3000 se permiten por defecto.
FRONTEND_ORIGIN=https://3-128-78-190.sslip.io
