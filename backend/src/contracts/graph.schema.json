{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spookython.example/schemas/grafo-manta-1.0.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "nodos",
    "aristas",
    "refugios"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ciudad",
        "graphVersion",
        "generatedAt",
        "source",
        "osmAttribution"
      ],
      "properties": {
        "ciudad": {
          "const": "Manta"
        },
        "graphVersion": {
          "type": "string",
          "minLength": 1
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "const": "OpenStreetMap"
        },
        "osmAttribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nodos": {
      "type": "array",
      "minItems": 250,
      "maxItems": 350,
      "items": {
        "$ref": "#/$defs/Nodo"
      }
    },
    "aristas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Arista"
      }
    },
    "refugios": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/Refugio"
      }
    }
  },
  "$defs": {
    "Nodo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lat",
        "lng",
        "zona"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "zona": {
          "enum": [
            "Tarqui",
            "Los Esteros",
            "Barbasquillo",
            "Jocay"
          ]
        }
      }
    },
    "Arista": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "segmentoId",
        "origen",
        "destino",
        "distancia_m",
        "tipo",
        "factor_velocidad"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "segmentoId": {
          "type": "string",
          "minLength": 1
        },
        "origen": {
          "type": "string",
          "minLength": 1
        },
        "destino": {
          "type": "string",
          "minLength": 1
        },
        "distancia_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tipo": {
          "enum": [
            "avenida",
            "calle",
            "callejon",
            "puente"
          ]
        },
        "factor_velocidad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "Refugio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodoId",
        "capacidad"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodoId": {
          "type": "string",
          "minLength": 1
        },
        "capacidad": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
