# Variables públicas del cliente. Nunca poner x-api-key aquí (SPEC.md §6):
# el bundle del navegador no debe contener secretos.
#
# Puerto 3001: default real de backend/src/server.ts (process.env.PORT ?? 3001).
# Si el backend corre con otro PORT, actualiza estas dos líneas para que
# coincidan — si no, el frontend intenta hablar con un puerto donde no hay
# nada escuchando y GET /estado y WSS /ws fallan en silencio.
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws

# Producción: no se versiona un .env.production (ver frontend/.gitignore).
# Configura VITE_API_BASE_URL/VITE_WS_URL como variables de entorno en la
# consola de AWS Amplify (Build settings → Environment variables), o crea
# localmente frontend/.env.production con el mismo formato de arriba para
# un build estático fuera de Amplify.
